# Product UI 的靜態伺服器 ＋ 每身分一個的後端 gateway。
#
# ## 這個檔案就是 UI 的權限邊界
#
# Range Core、Evidence API、Admission 的身分都由**部署時注入的服務 token**換出。
# 那個保證（「呼叫者無法自報身分」）只在 token 不在呼叫者手上時才成立 ——
# 所以 token 一路到這裡為止，瀏覽器拿不到、也不需要拿到。
#
# 前綴決定身分：`/gw/blue/...` 的請求會被貼上 blue 的 token，clearance 就是 blue，
# 後端據此做欄位級遮蔽。前端沒有任何辦法要求更高的 clearance —— 它連 token
# 長什麼樣都不知道。這與 `disclosure.identity` 的設計是同一件事的兩端。
#
# ## envsubst
#
# 官方 nginx 映像的 entrypoint 會把 `/etc/nginx/templates/*.template` 做環境變數
# 展開後放到 `/etc/nginx/conf.d/`。所以本檔只含 `server`／`map`，不含 `http {}`。

# WebSocket 升級（ttyd 終端機走 `/terminal/`，見下方 location）。
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# token 表：身分 → 該身分在各服務的 token。**表以外沒有第二個地方決定誰是誰。**
# 沒設到的身分拿到空字串 → 後端回 403（fail closed，不是預設放行）。
map $gw_id $core_token {
    default    "";
    red        "${RANGE_CORE_TOKEN_RED}";
    blue       "${RANGE_CORE_TOKEN_BLUE}";
    purple     "${RANGE_CORE_TOKEN_PURPLE}";
    instructor "${RANGE_CORE_TOKEN_INSTRUCTOR}";
}

map $gw_id $evidence_token {
    default    "";
    blue       "${PURPLE_EVIDENCE_TOKEN_BLUE}";
    purple     "${PURPLE_EVIDENCE_TOKEN_PURPLE}";
    instructor "${PURPLE_EVIDENCE_TOKEN_INSTRUCTOR}";
}

server {
    listen 8080;
    server_name _;

    # proxy_pass 帶變數時需要 resolver（Docker 內建 DNS）。
    resolver 127.0.0.11 ipv6=off valid=10s;

    set $range_core   "${UI_RANGE_CORE_UPSTREAM}";
    set $evaluation   "${UI_EVALUATION_UPSTREAM}";
    set $evidence     "${UI_EVIDENCE_UPSTREAM}";
    set $admission    "${UI_ADMISSION_UPSTREAM}";
    set $admission_edge "${UI_ADMISSION_EDGE_UPSTREAM}";
    set $grafana      "${UI_GRAFANA_UPSTREAM}";

    # 前端一律同源，不需要 CORS；順手擋掉點擊劫持與 MIME 猜測。
    add_header X-Frame-Options SAMEORIGIN always;
    add_header X-Content-Type-Options nosniff always;

    # ---------- 靜態畫面 ----------

    root /usr/share/nginx/html;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    # 教官與紫隊的畫面不是公開層。#126 item 2 之前，網段限制是**唯一**擋得住
    # 「拿到網址就進得去」的東西。現在加了第二層：`auth_request` 問 Admission
    # 這個瀏覽器有沒有登入教官（見下面的 `/_auth_instructor`）——CIDR 仍然保留，
    # 不是取代，是補強（見 ui/README.md 已知缺口）。
    #
    # 登入頁本身故意落在這條 regex 之外（`/instructor-login/`，不是
    # `/instructor/`）：它不能被自己要求的 cookie 擋住，否則永遠登不進去。
    # CIDR 完全不擋 `/instructor-login/`——頁面本身不做任何特權動作，
    # 真正的憑證檢查在 `/admission/instructor/login`（同樣不受 auth_request 保護，
    # 但那條路徑仍然要求 CIDR，見下方 gateway location）。
    location ~ ^/(instructor|purple|event-control)/ {
        allow ${UI_PRIVILEGED_CIDR};
        deny all;
        auth_request /_auth_instructor;
        error_page 403 = @not_authorized;
        try_files $uri $uri/ =404;
    }

    # 裸的 nginx 403 頁不會告訴使用者「兩層防線」裡是哪一層擋的（CIDR 還是
    # 沒登入），也不會提到 /instructor-login/ 存在。這裡換成一頁説明，狀態碼
    # 仍是 403（不能用 redirect：CIDR 擋下的人導去登入頁一樣會失敗，那樣的
    # 導頁反而是誤導）。
    location @not_authorized {
        default_type text/html;
        return 403 '<!doctype html><meta charset="utf-8"><title>403 — 沒有教官權限</title><body style="font-family:system-ui,sans-serif;max-width:32em;margin:4em auto;line-height:1.6"><h1>沒有教官權限</h1><p>可能原因：這個瀏覽器還沒登入教官 session，或這台機器的網段不在允許清單內。</p><p><a href="/instructor-login/">前往教官登入</a></p></body>';
    }

    location = /_auth_instructor {
        internal;
        proxy_pass http://$admission/admission/auth/instructor;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
    }

    # ---------- Battleboard 揭露開關 ----------
    #
    # 這兩塊必須排在下面通用的 eval gateway 之前（regex location 依出現順序比對）。
    # `revealed` 由前綴決定，不是呼叫端 —— 公開層前綴一律強制 false。

    # 查詢字串寫死在 proxy_pass 裡，**不用** `$is_args$args`：`$is_args` 由
    # 原始請求決定，客戶端沒帶查詢字串時它是空的，`set $args` 設進去的值會被
    # 整段丟掉。那樣公開層仍安全（後端預設 false），但 instructor 會靜默地
    # 拿到 pending 狀態 —— 一個不會有任何錯誤訊號的失效。
    location ~ ^/gw/(?:red|blue|purple)/eval/(?<bb_public>api/exercises/[^/]+/battleboard)$ {
        proxy_pass http://$evaluation/$bb_public?revealed=false;
    }

    location ~ ^/gw/instructor/eval/(?<bb_admin>api/exercises/[^/]+/battleboard)$ {
        proxy_pass http://$evaluation/$bb_admin?revealed=true;
    }

    # ---------- Range Core ----------

    # SSE 專用：關掉緩衝（buffering 開著時事件會卡在 nginx 裡直到湊滿一個 buffer，
    # 「即時推送」就變成批次），並把逾時放到大於後端 300 秒的連線壽命上限。
    location ~ ^/gw/(?<gw_id>red|blue|purple|instructor)/core/api/events/live$ {
        proxy_set_header Authorization "Bearer $core_token";
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 3600s;
        proxy_pass http://$range_core/api/events/live;
    }

    # 名冊歸屬的兩條端點（#126 item 4）。必須排在下面通用的 core gateway 之前。
    #
    # 為什麼只有這兩條要特別處理：flag 提交與 hint 用來源 IP 當名冊的鍵，而
    # `range_core` 的 `_source_ip` 刻意不信任 `X-Forwarded-For`（信了就等於讓
    # 一個紅隊玩家能用別人的身分提交 flag）。經這個共用 gateway 進來的請求，
    # Range Core 看到的是**這台 nginx** 的位址，於是每一次提交都 403。
    #
    # 解法不是「開始相信某個標頭」，而是讓已經握有服務 token 的這一台去問
    # Admission「這個 session 坐哪台機器」，把答案放進 `X-Seat-Source-Ip`。
    # Range Core 只在 TCP peer 真的是這台時才採信（見 `_source_ip` 的 docstring）。
    #
    # 為什麼是這裡而不是 Z-EDGE：代宣告來源 IP 需要同時握有 Range Core 的服務
    # token，而 Z-EDGE 必須維持零憑證（WS8 spec §5.3）。token 已經在這裡了。
    location ~ ^/gw/red/core/(?<roster_path>api/(?:submissions|hints))$ {
        auth_request /_auth_seat;
        auth_request_set $seat_source_ip $upstream_http_x_seat_source_ip;

        # 客戶端送進來的同名標頭一律丟掉，只留 auth_request 的答案 —— 少了這一
        # 行，瀏覽器自己塞一個就會被原封不動轉給 Range Core。
        proxy_set_header X-Seat-Source-Ip $seat_source_ip;
        proxy_set_header Authorization "Bearer ${RANGE_CORE_TOKEN_RED}";
        proxy_pass http://$range_core/$roster_path$is_args$args;
    }

    location = /_auth_seat {
        internal;
        proxy_pass http://$admission/admission/auth/seat;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        proxy_set_header X-Seat-Source-Ip "";
    }

    location ~ ^/gw/(?<gw_id>red|blue|purple|instructor)/core/(?<core_path>.*)$ {
        proxy_set_header Authorization "Bearer $core_token";
        proxy_pass http://$range_core/$core_path$is_args$args;
    }

    # ---------- Evaluation Engine ----------
    #
    # 沒有 token：Evaluation API 本身不做身分驗證。它之所以還是安全的，是因為
    # 它只住 Z-MGMT、不對外發佈 —— 瀏覽器唯一到得了它的路徑就是這條 gateway。
    # 這件事一旦改變（例如把 8002 port 對外開），這個假設就破了。

    location ~ ^/gw/(?:red|blue|purple|instructor)/eval/(?<eval_path>.*)$ {
        proxy_pass http://$evaluation/$eval_path$is_args$args;
    }

    # ---------- Evidence API ----------

    location ~ ^/gw/(?<gw_id>blue|purple|instructor)/evidence/(?<evidence_path>.*)$ {
        proxy_set_header Authorization "Bearer $evidence_token";
        proxy_pass http://$evidence/evidence/$evidence_path;
    }

    # ---------- SOC Copilot（#133，只有 instructor 有這條）----------
    #
    # 只給教官用，同一個 evidence upstream 上的 `/copilot/summary`，用同一把
    # instructor token（後端 handle_copilot_summary 自己再檢查一次身分是不是
    # instructor，這裡的 regex 只擋 URL 層級——兩層都要擋，任何一層漏了都
    # 還有另一層兜底，見 purple/evidence/service.py 的 docstring）。刻意不放
    # 進上面 blue|purple|instructor 那條 evidence 規則裡，因為這條路徑存不
    # 存在本身就敏感（#133 驗收：不經過任何會被 Blue SOC／Player Portal
    # 讀到的路徑）。
    location = /gw/instructor/copilot/summary {
        proxy_set_header Authorization "Bearer ${PURPLE_EVIDENCE_TOKEN_INSTRUCTOR}";
        proxy_pass http://$evidence/copilot/summary;
    }

    # ---------- Admission（只有 instructor 有這條）----------

    # 登入／登出本身不受 auth_request 保護——登入端點要是被自己發的 cookie
    # 擋住，就沒有人能拿到第一張 cookie；登出則是「session 可能已經過期還是要
    # 讓清 cookie 這個動作成功」。CIDR 仍然是這兩條路徑唯一的外圍防線，
    # 跟其餘教官端點一致。用 `=` 精確比對：nginx 的 location 選址規則裡精確
    # 比對永遠贏過下面的正規表達式 location，不需要靠檔案順序保證優先權。
    location = /gw/instructor/admission/instructor/login {
        allow ${UI_PRIVILEGED_CIDR};
        deny all;
        proxy_pass http://$admission/admission/instructor/login;
    }

    location = /gw/instructor/admission/instructor/logout {
        allow ${UI_PRIVILEGED_CIDR};
        deny all;
        proxy_pass http://$admission/admission/instructor/logout;
    }

    location ~ ^/gw/instructor/admission/(?<admission_path>.*)$ {
        allow ${UI_PRIVILEGED_CIDR};
        deny all;
        auth_request /_auth_instructor;
        proxy_set_header Authorization "Bearer ${ADMISSION_INSTRUCTOR_TOKEN}";
        proxy_pass http://$admission/admission/$admission_path$is_args$args;
    }

    # ---------- Admission（玩家自助領位，公開層）----------
    #
    # Event Control 簽的一次性連結／現場進場碼，玩家是在還沒有任何 session、
    # 也不在 UI_PRIVILEGED_CIDR 網段的情況下點進來的——這條線本來就該落在
    # CIDR／auth_request 兩層防線**之外**，跟教官那組是相反的信任模型：
    # 這裡不是「先證明你是教官」，是「你手上的 token／進場碼本身就是憑證」，
    # 驗證在 admission 服務內部做（claim 端點自己核對 token／進場碼）。
    #
    # 只開 join（渲染表單）與 claims（送出領位）這兩條，不是整個 /admission/
    # 前綴——同一個前綴下還有 /admission/seats/pending、/admission/instructor/*
    # 這些教官專用端點，開放整段會直接繞過上面那組 CIDR／auth_request 防線。
    # pre-UAT 2026-08-17 發現：這條路徑先前完全沒被曝光，Event Control 簽出的
    # 連結點下去是裸 404——玩家自助領位這條路實測前從未真的走通過。
    location ~ ^/admission/(?<join_path>[^/]+/(?:join|claims))$ {
        proxy_pass http://$admission/admission/$join_path$is_args$args;
    }

    # ---------- ttyd 終端機（玩家 Shell，轉給 Z-EDGE）----------
    #
    # `ui/player/app.js` 刻意用相對路徑 `/terminal/<id>`（同源，不是
    # 寫死某個埠）——它的註解說「Z-EDGE 的 nginx 先打」，代表這條線本來就該
    # 存在：玩家瀏覽器只認 :8090 這個 origin，ttyd 的 auth_request／Cookie
    # 剝除仍然整段發生在 Z-EDGE（deploy/edge/nginx.conf）裡，這裡只是把
    # bytes 轉進去，沒有另外驗證、沒有另外碰 Cookie——Z-EDGE 零憑證的邊界
    # 沒有被這一層繞過。pre-UAT 2026-08-17 發現：這條線先前完全沒接，
    # 玩家 Shell 面板打 `/terminal/<id>` 在 :8090 上只會撞 nginx 靜態根目錄
    # 的裸 404。
    # 路徑刻意比對「這個 terminal id 之後任意子路徑」，不是精準單一段——
    # ttyd 開了 `--base-path /terminal/<id>` 之後，真正會被打到的不只
    # `/terminal/<id>` 本身：先是 302 補上尾斜線、接著是 `.../token`
    # （CSRF token）、`.../ws`（實際終端機的 WebSocket）。第一版這裡只比對
    # 單一段、且 proxy_pass 帶了固定路徑（等於把尾斜線／子路徑一律砍掉），
    # 結果是瀏覽器跟 ttyd 之間的尾斜線重導向來回無限跳
    # （ERR_TOO_MANY_REDIRECTS，pre-UAT 2026-08-17 發現）。這裡改成不帶路徑
    # 的 `proxy_pass`（只給 host:port），nginx 會把原始請求 URI 整段原封不動
    # 轉過去——跟 deploy/edge/nginx.conf 自己那條 `/terminal/` location 對
    # ttyd upstream 的作法完全一致。
    location ~ ^/terminal/(?<terminal>[A-Za-z0-9_-]+)(?:/.*)?$ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_pass http://$admission_edge;
    }

    # ---------- Grafana（Blue SOC 的儀表板分頁）----------

    # #162：`proxy_pass` 結尾的 `/` 會把比對到的 `/grafana/` 前綴整段砍掉再轉給
    # 上游——但 Grafana 這邊設了 GF_SERVER_SERVE_FROM_SUB_PATH=true（docker-compose.yml），
    # 意思是它預期收到的請求路徑**保留**這個前綴才對得上自己的 root_url。兩邊
    # 剛好互相打架：Grafana 收到被砍過的 `/`，判定跟它認知的子路徑對不上，用
    # root_url 組一個絕對網址 302 回去——而 root_url 的 domain/port 是 Grafana
    # 自己的 localhost:3000，不是玩家瀏覽器打的 :8090，於是重導向指去玩家
    # 瀏覽器自己的 localhost:3000（什麼都沒有），不是指去這台主機。
    # 不帶路徑的 proxy_pass（同 `/terminal/` 那條 location 的作法）讓原始 URI
    # 整段原封不動轉過去，跟 SERVE_FROM_SUB_PATH 的期待對上。
    location /grafana/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_pass http://$grafana;
    }

    location = /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Instructor Console 的 Grafana 可見性補償（#126）：Grafana 是唯一 alert
    # engine，掛了偵測全停不會有信號。這裡不做告警管線，只補一個沒有身分限制
    # 的 liveness passthrough——`/api/health` 不含敏感資料，跟上面 `/healthz`
    # 自我檢查同一等級，Instructor Console 直接 fetch 顯示狀態燈。
    location = /health/grafana {
        access_log off;
        proxy_pass http://$grafana/api/health;
    }
}
