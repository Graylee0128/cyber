FROM python:3.12-slim
WORKDIR /app
COPY pyproject.toml /app/pyproject.toml
COPY src /app/src
COPY config /app/config
COPY deploy/grafana/provisioning/alerting/rules.yaml /app/deploy/grafana/provisioning/alerting/rules.yaml
COPY deploy/admission/scenarios /app/scenarios
RUN pip install --no-cache-dir --timeout 120 --retries 10 -e . uvicorn
EXPOSE 8000
CMD ["uvicorn", "range_core.api:app", "--host", "0.0.0.0", "--port", "8000"]
