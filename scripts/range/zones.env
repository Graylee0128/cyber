# PurpleScope range 分區定址 —— **全系統唯一定義處**（SA §12 四區的實作位址）。
#
# 為什麼獨立成檔：這些位址原本以字面值散在 6 個檔案（shell、Alloy 設定、Python 測試），
# 改一個位址要改六處，漏掉任何一處的症狀都出現在很後面（測試連不到、Loki 沒事件），
# 極難回推。現在 shell 直接 source 本檔，Python 用 `purple.range_zones.load_zones()` 讀。
#
# 格式刻意保持 `KEY=value` 純字面值、不做變數展開 —— 兩種語言都能零依賴解析。
# 代價是 gateway 之類的衍生值看起來重複；那份一致性由
# `tests/range/test_zones_env.py` 機器檢查，漂掉會紅燈，不靠人盯。
#
# 唯一無法 source 本檔的是 `deploy/range-target/config.alloy`（Alloy 自己的語法，
# 且被烤進 golden image）。它的 push URL 由同一支測試比對，不會默默漂移。

RANGE_BRIDGE=br-range
RANGE_NET_PREFIX=10.167

# VLAN id ＝ 位址第三段（SA §12 的四區）
Z_MGMT_VLAN=10
Z_TARGET_VLAN=20
Z_RED_VLAN=30
Z_APP_VLAN=40

# 各區 gateway（都在 ns-router 上）
Z_MGMT_GW=10.167.10.1
Z_TARGET_GW=10.167.20.1
Z_RED_GW=10.167.30.1
Z_APP_GW=10.167.40.1

# Z-MGMT 住戶
MGMT_STUB_IP=10.167.10.10
MGMT_LOKI_IP=10.167.10.20
LOKI_PUSH_URL=http://10.167.10.20:3100/loki/api/v1/push

# Z-TARGET 靶機
TARGET_IP=10.167.20.10

# Z-RED 六台紅隊：10.167.30.11 ~ .16
RED_IP_FIRST=10.167.30.11
RED_COUNT=6

# Z-APP 目前**已佈線但無住戶** —— 住戶是 WS5 Range Core 與 WS7 Product UI，尚未開工
# （SA §4.2）。這是待建，不是漏建，所以這裡只有 gateway 沒有節點位址。
